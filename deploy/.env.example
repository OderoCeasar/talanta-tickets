# Copy to /opt/talanta/.env on the Hetzner server and fill in real values. NEVER commit the
# real file. `chmod 600 .env`. The CI deploy reads this file via docker compose.

# The image the CI pushes to GHCR: ghcr.io/<owner>/<repo>:latest, all lowercase.
API_IMAGE=ghcr.io/oderoceasar/talanta-tickets:latest

# The docker network of the Caddy container in /opt/sherehe (check with `docker network ls`).
CADDY_NETWORK=sherehe_default

# Postgres superuser password for this stack's own database container.
# Generate with `openssl rand -hex 24` — hex keeps it safe to embed in the URL below.
POSTGRES_PASSWORD=

# --- API config ---
ADDR=:8080
# Host is the `talanta-db` service; same password as POSTGRES_PASSWORD. No TLS needed: the
# database is only reachable on this stack's private docker network.
DATABASE_URL=postgres://talanta:PASSWORD@talanta-db:5432/talanta?sslmode=disable
