# Local development. Copy to backend/.env; `make dev` and `make backend` both read it.
# Every value here is fake. Real secrets never go in git.

# development | test | production, matched exactly. UNSET MEANS PRODUCTION: dev-only shortcuts
# (the sign-in code in the API answer, the public JWT secret) are on only when this says
# development or test.
APP_ENV=development
ADDR=:8080
DATABASE_URL=postgres://talanta:talanta@localhost:5434/talanta?sslmode=disable
# debug | info | warn | error
LOG_LEVEL=info
# Browser origins allowed to call the API (the admin site in dev).
CORS_ORIGINS=http://localhost:5173

# --- Auth -------------------------------------------------------------------
# Signs access tokens. REQUIRED in production, at least 32 bytes
# (`openssl rand -base64 48`). In development and test it may be left unset: a fixed, public
# default is used and the API logs a loud warning.
# JWT_SECRET=change-me-to-at-least-32-random-bytes
# Where the admin site is served. Invitation links are ADMIN_BASE_URL/invite/<token>.
# REQUIRED in production and must be https:// there (no default; the API refuses to start).
# In development and test it defaults to http://localhost:5173.
ADMIN_BASE_URL=http://localhost:5173
# Booking fee in basis points of the ticket subtotal (250 = 2.5%), rounded down to a whole
# cent. 0 means no fee. Shown on a hold as an estimate and charged on the booking.
# BOOKING_FEE_BPS=0

# How many argon2 password hashes or checks may run at once (each holds 19 MiB and a core).
# Further requests wait their turn; one that is still waiting when its request times out
# gets 429.
# ARGON2_MAX_CONCURRENT=4

# --- Phone sign-in codes (SMS) ------------------------------------------------
# Calling codes a sign-in code may be sent to, comma-separated, digits only. Other numbers
# get a validation error on `phone` and no SMS.
# OTP_ALLOWED_COUNTRY_CODES=254
# Caps on sign-in SMS across ALL phones. When one is reached, code requests answer 429 and
# the API logs "ALERT: global sign-in SMS cap reached" at error level: alert on that line.
# OTP_GLOBAL_HOURLY_LIMIT=2000
# OTP_GLOBAL_DAILY_LIMIT=10000

# First admin. When BOTH are set and the database has no ADMIN user, the API creates this
# admin at startup (password at least 10 characters). Once any admin exists they are ignored.
# In development the seeder creates admin@talanta.test instead, so leave them unset.
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# --- Tickets ------------------------------------------------------------------
# Signs the QR code of every ticket (Ed25519). Base64 of the 32-byte seed
# (`openssl rand -base64 32`) or of the 64-byte private key. REQUIRED in production: the API
# refuses to start without it, with a malformed one, or with the test key printed in
# docs/TICKET_FORMAT.md. It is never logged or returned; gate devices get the public key only.
# In development and test it may be left unset: a random key is made at startup (key ID k0)
# and the API logs a loud warning, because tickets signed with it stop verifying when the
# process ends. Set it locally if you want tickets to survive a restart.
# The value below is the PUBLISHED TEST KEY. Never use it outside development.
# TICKET_SIGNING_KEY=nWGxne/9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A=
# The ID of that key: the letter k and a number from 1 to 65535. Default k1. It is written
# into every ticket and stored with it. When you change the key, give the new one a new ID
# (k2, k3, ...); never re-use an ID for a different key.
# TICKET_SIGNING_KEY_ID=k1
# Public keys of RETIRED signing keys, so tickets they signed still verify:
# comma-separated <key id>:<base64 of the 32-byte public key>. Optional. To rotate: put the
# old key's ID and PUBLIC key here, then set the new TICKET_SIGNING_KEY and its new ID.
# TICKET_VERIFY_KEYS=k1:11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo
# The origin a fan's phone reaches this API at. The link in the "your tickets" SMS is
# PUBLIC_BASE_URL/v1/t/<web token>. REQUIRED in production and must be https:// there (no
# default; the API refuses to start). In development and test it defaults to
# http://localhost:8080. Keep it short: the link is 64 characters longer than this value and
# the whole SMS should fit in 160.
PUBLIC_BASE_URL=http://localhost:8080

# --- Reverse proxy ----------------------------------------------------------
# Networks our own proxy connects from, comma-separated CIDRs. Forwarding headers are
# believed ONLY on connections from these. Behind Caddy on a docker network, set it to that
# network's range.
# REQUIRED in production: either a range, or the word `none`, which means "the API is exposed
# directly, there is no proxy, believe no forwarding header". Left empty in production the
# API refuses to start, because behind a proxy every caller would share one rate-limit
# bucket. In development and test, empty (the default) trusts nobody: the TCP peer is the
# client.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12
# The caller's address is the right-most X-Forwarded-For entry that is not one of our
# proxies. CLIENT_IP_HEADER names a single-address header to believe first; it is EMPTY by
# default. Set it (for example to CF-Connecting-IP) ONLY when the origin accepts connections
# solely from the CDN that writes it (firewall or tunnel), or when the proxy overwrites it.
# Caddy passes the header through untouched, so on an origin anyone can reach it would let a
# caller choose their own address.
# CLIENT_IP_HEADER=

# --- Timeouts ---------------------------------------------------------------
# HTTP_WRITE_TIMEOUT must be longer than REQUEST_TIMEOUT.
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=60s
# HTTP_IDLE_TIMEOUT=120s
# REQUEST_TIMEOUT=30s
# Per database session: one statement may run this long; a transaction may sit idle this long.
# DB_STATEMENT_TIMEOUT=15s
# DB_IDLE_IN_TX_TIMEOUT=15s

# --- Mail (staff invitations) -----------------------------------------------
# With SMTP_HOST unset, invitation emails are not sent and the admin copies the link from the
# screen (in development the mail is written to the log; in production its text never is).
# Port 465 is implicit TLS; other ports MUST upgrade with STARTTLS. If the server does not
# offer it the mail is not sent (the invitation itself still succeeds), unless the host is
# loopback or SMTP_ALLOW_PLAINTEXT=true.
# SMTP_ALLOW_PLAINTEXT=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Talanta Tickets <no-reply@example.com>

# Worker
SWEEP_INTERVAL=30s
RECONCILE_INTERVAL=30s
