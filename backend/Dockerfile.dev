# Local development image, used only by the root docker-compose.yml. It holds the api, the
# worker and the seeder; compose picks which one to run. The production image is built from
# ./Dockerfile by the deploy workflow and is not affected by this file.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/ ./cmd/...

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/ /usr/local/bin/
USER 65534:65534
EXPOSE 8080
ENTRYPOINT ["api"]
